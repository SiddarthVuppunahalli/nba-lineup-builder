{
  "name": "@lineup-engine/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/persistence/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lineup-engine/basketball-engine": "workspace:*",
    "@lineup-engine/nba-data": "workspace:*",
    "@lineup-engine/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "openai": "^7.15.0",
    "postgres": "^3.4.9",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0"
  }
}
