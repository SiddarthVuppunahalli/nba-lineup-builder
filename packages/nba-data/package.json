{
  "name": "@lineup-engine/nba-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "snapshot:generate": "node scripts/generate-current-snapshot.mjs",
    "snapshot:check": "node scripts/generate-current-snapshot.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lineup-engine/basketball-engine": "workspace:*"
  }
}
