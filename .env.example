# Hosting providers normally assign PORT. API_PORT remains available for local compatibility.
PORT=3001
HOST=0.0.0.0

# Optional override when the frontend build is stored somewhere else.
# WEB_DIST_DIR=apps/web/dist

# Optional Phase 6 natural-language interpretation. Keep this value in local/Replit secrets.
# OPENAI_API_KEY=
OPENAI_INTENT_MODEL=gpt-5.6-luna

# Optional Phase 9 durable scenario storage. Run `pnpm db:migrate` after provisioning it.
# DATABASE_URL=postgres://user:password@host:5432/database
